{
  "expo": {
    "name": "Ironbound",
    "slug": "ironbound-step-rpg",
    "version": "2.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020b19",
    "scheme": "ironbound",
    "plugins": [
      "./plugins/with-step-detector"
    ],
    "android": {
      "package": "com.m1l3s99.ironbound",
      "versionCode": 10,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.m1l3s99.ironbound",
      "supportsTablet": false,
      "infoPlist": {
        "NSMotionUsageDescription": "Ironbound uses your step count for live daily progress.",
        "NSLocationWhenInUseUsageDescription": "Ironbound uses your location to apply the local weather crop bonus."
      }
    }
  }
}
